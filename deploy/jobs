#!/usr/bin/env bash
# jobsworld：装好之后的命令入口（也装了一个叫 jobs 的别名，但 jobs 是 shell 的内建命令，在终端里请用 jobsworld）。管理服务本身的几个子命令在这里处理，其余原样交给容器里的 Jobs 命令行（publish / status / report / mcp …）。
set -euo pipefail
JOBS_HOME="${JOBS_HOME:-$HOME/.jobs}"
[ -f "$JOBS_HOME/compose.yml" ] || { echo "没有找到 Jobs 的安装目录（$JOBS_HOME）。先安装：curl -fsSL https://jobs.plutokeating.beer/install | bash" >&2; exit 1; }
if docker info >/dev/null 2>&1; then DOCKER=(docker); elif sudo -n docker info >/dev/null 2>&1; then DOCKER=(sudo docker); else DOCKER=(docker); fi
dc() { (cd "$JOBS_HOME" && "${DOCKER[@]}" compose "$@"); }
envv() { grep -E "^$1=" "$JOBS_HOME/.env" 2>/dev/null | head -1 | cut -d= -f2-; }
port() { local p; p="$(envv JOBS_PORT)"; echo "${p:-7777}"; }
ensure_gcloud() {  # 把这台机器的 gcloud 配置目录写进 .env（JOBS_GCLOUD_DIR，编排里只读挂进容器）。目录还不存在就先建一个空的（属于当前用户），以后再装 gcloud、登录，容器里直接看得到
  local d h
  d="$(envv JOBS_GCLOUD_DIR || true)"
  if [ -z "$d" ]; then
    h="${HOME:-}"; [ -n "$h" ] || h="$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f6 || true)"   # systemd 执行网页上的请求时不一定有 HOME
    [ -n "$h" ] || return 0
    d="${CLOUDSDK_CONFIG:-$h/.config/gcloud}"
    printf '\n# 这台机器的 gcloud 配置目录，只读挂进容器：「模型」页的「使用这台机器的 gcloud 登录」读它\nJOBS_GCLOUD_DIR=%s\n' "$d" >> "$JOBS_HOME/.env"
  fi
  mkdir -p "$d" 2>/dev/null || true
}
lan_ip() { (hostname -I 2>/dev/null | awk '{print $1}') || true; }
game() {  # game on|off [tshock|tml]
  local act="${1:-}" kind="${2:-tshock}"
  case "$kind" in tshock|tml) ;; *) echo "游戏服只有 tshock（原版 Terraria）和 tml（tModLoader）" >&2; exit 2;; esac
  case "$act" in
    on) dc --profile game up -d "$kind" ;;
    off) dc --profile game stop "$kind" ;;
    *) echo "用法：jobsworld game on|off [tshock|tml]" >&2; exit 2 ;;
  esac
}
refresh_files() {  # 编排文件与本脚本都在镜像里：换了镜像就重新取一遍，保证两边版本一致
  local img; img="$(envv JOBS_IMAGE)"; img="${img:-ghcr.io/plutokeating/jobs:latest}"
  for f in compose.yml compose.host.yml compose.bridge.yml; do "${DOCKER[@]}" run --rm --entrypoint cat "$img" "/app/deploy/$f" > "$JOBS_HOME/$f.new" && mv "$JOBS_HOME/$f.new" "$JOBS_HOME/$f" || return 1; done
  # 用 mv 换掉本脚本：正在运行的这一份（已打开的旧文件）不受影响
  "${DOCKER[@]}" run --rm --entrypoint cat "$img" /app/deploy/jobs > "$JOBS_HOME/jobs.new" && chmod +x "$JOBS_HOME/jobs.new" && mv "$JOBS_HOME/jobs.new" "$JOBS_HOME/jobs"
}

running_version() { curl -fsS -m 3 "http://127.0.0.1:$(port)/healthz" 2>/dev/null | sed -n 's/.*"version":"\([^"]*\)".*/\1/p' || true; }
backup() {  # 把数据库导出到 ~/.jobs/backups（只留最近 5 份）；数据库没在运行时跳过
  local dir="$JOBS_HOME/backups" v f
  if [ -z "$(dc ps --status running -q postgres 2>/dev/null)" ]; then echo "数据库没在运行，跳过备份。"; return 0; fi
  mkdir -p "$dir"; v="$(running_version)"
  f="$dir/jobs-$(date -u +%Y%m%dT%H%M%SZ)${v:+-v$v}.dump"
  if ! (umask 077; dc exec -T postgres pg_dump -U jobs -Fc jobs < /dev/null > "$f.part"); then rm -f "$f.part"; echo "数据库备份失败。" >&2; return 1; fi
  mv "$f.part" "$f"
  ls -1t "$dir"/jobs-*.dump 2>/dev/null | tail -n +6 | while IFS= read -r old; do rm -f "$old"; done
  echo "数据库已备份：$f"
}
game_services() {  # 装过（建过容器）的游戏服；带 running 时只列出正在运行的
  local s
  for s in tshock tml; do
    if [ "${1:-}" = running ]; then [ -n "$(dc --profile game ps --status running -q "$s" 2>/dev/null)" ] && echo "$s"
    else [ -n "$(dc --profile game ps -a -q "$s" 2>/dev/null)" ] && echo "$s"; fi
  done; return 0
}
refresh_games() {  # 游戏服在 profile 里，普通的 pull / up 不会碰它们：装过的拉新镜像，正在运行的换上新镜像
  local all run
  all="$(game_services | xargs)"; [ -n "$all" ] || return 0
  # shellcheck disable=SC2086
  if [ -z "${JOBS_SKIP_PULL:-}" ]; then dc --profile game pull $all || return 1; fi
  run="$(game_services running | xargs)"
  # shellcheck disable=SC2086
  if [ -n "$run" ]; then dc --profile game up -d $run || return 1; fi
}
wait_ready() {
  local i
  for i in $(seq 1 120); do
    if [ -n "$(running_version)" ]; then return 0; fi
    sleep 3
  done
  return 1
}
# ---- 版本比较：先看本机的版本和要升级到的版本，确实有新版本（或者要求强制）才动手 ----
image() { local i; i="$(envv JOBS_IMAGE)"; echo "${i:-ghcr.io/plutokeating/jobs:latest}"; }
image_version() {  # 本机已有的某个镜像里装的是哪一版（不联网；本机没有这个镜像时为空）
  "${DOCKER[@]}" image inspect "$1" >/dev/null 2>&1 || return 0
  "${DOCKER[@]}" run --rm --entrypoint node "$1" -p "require('/app/package.json').version" 2>/dev/null || true
}
latest_release() {  # GitHub 上最新的正式发布（镜像都推上去之后才建，和网页上的升级提示同一个来源）；查不到时为空
  curl -fsSL -m 10 -H 'accept: application/vnd.github+json' -H 'user-agent: jobs-update-check' "${JOBS_UPDATE_URL:-https://api.github.com/repos/PlutoKeating/Project.Jobs/releases/latest}" 2>/dev/null \
    | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"[vV]\{0,1\}\([^"]*\)".*/\1/p' | head -1 || true
}
target_version() {  # 要升级到的版本，输出「版本|来源」；不知道时版本为空
  local img tag
  img="$(image)"
  if [ -n "${JOBS_SKIP_PULL:-}" ]; then echo "$(image_version "$img")|本机的镜像 $img"; return 0; fi
  case "$img" in *@sha256:*) echo "|按摘要固定的镜像 $img"; return 0;; esac
  tag="${img##*/}"; case "$tag" in *:*) tag="${tag##*:}";; *) tag=latest;; esac
  if [ "$tag" = latest ]; then
    case "$img" in ghcr.io/plutokeating/jobs:latest|ghcr.io/plutokeating/jobs) echo "$(latest_release)|GitHub 上最新的发布"; return 0;; esac
  elif printf '%s' "$tag" | grep -Eq '^[vV]?[0-9]+\.[0-9]+\.[0-9]+'; then echo "${tag#[vV]}|.env 里锁定的版本"; return 0; fi
  echo "|自己指定的镜像 $img"
}
ver_gt() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }
# 要不要真的升级：返回 0 = 要；1 = 不用（原因已经打印）。src 是来源（GitHub 上最新的发布时，本机更新就不降级），hint 是强制的写法
need_update() {
  local cur="$1" target="$2" src="$3" hint="${4:-jobsworld update --force}"
  if [ -z "$cur" ]; then echo "看不到本机正在运行的版本（服务没在运行），照常拉取并重建。"; return 0; fi
  if [ -z "$target" ]; then echo "查不到要升级到的版本（$src；或者访问不了 GitHub）。本机是 $cur，没有改动。确定要重新拉取并重建：$hint"; return 1; fi
  if [ "$cur" = "$target" ]; then echo "已经是最新版本 $cur（$src），没有改动。要强制重新拉取并重建：$hint"; return 1; fi
  if [ "$src" = "GitHub 上最新的发布" ] && ver_gt "$cur" "$target"; then echo "本机的 $cur 比 GitHub 上最新的发布 $target 还新，没有改动。"; return 1; fi
  echo "本机 $cur → $target（$src）。"; return 0
}

update() {  # 函数里逐步检查返回值：在 if 里调用时 set -e 不起作用
  local before after force="" check="" a t target src
  for a in "$@"; do
    case "$a" in
      -f|--force) force=1 ;;
      --check) check=1 ;;
      *) echo "用法：jobsworld update [--check | --force]" >&2; return 2 ;;
    esac
  done
  [ -n "${JOBS_FORCE_UPDATE:-}" ] && force=1
  before="$(running_version)"
  echo "== 检查版本 =="
  t="$(target_version)"; target="${t%%|*}"; src="${t#*|}"
  if [ -n "$check" ]; then
    echo "本机：${before:-（服务没在运行）}"; echo "可升级到：${target:-（查不到）}（$src）"
    if [ -n "$before" ] && [ -n "$target" ] && [ "$before" != "$target" ] && ! { [ "$src" = "GitHub 上最新的发布" ] && ver_gt "$before" "$target"; }; then echo "有新版本：jobsworld update"; else echo "没有可升级的版本。"; fi
    return 0
  fi
  if [ -n "$force" ]; then echo "强制重新拉取并重建（本机 ${before:-未知}，${src} ${target:-未知}）。"
  elif ! need_update "$before" "$target" "$src"; then return 0; fi
  if [ -z "${JOBS_SKIP_PULL:-}" ]; then echo "== 拉取新镜像 =="; dc pull || return 1; fi   # 自己构建的镜像：JOBS_SKIP_PULL=1
  refresh_files || { echo "从新镜像取编排文件失败。" >&2; return 1; }
  if [ -z "${JOBS_SKIP_BACKUP:-}" ]; then echo "== 备份数据库 =="; backup || { echo "备份失败，没有升级（数据没有动）。确定不要备份：JOBS_SKIP_BACKUP=1 jobsworld update" >&2; return 1; }; fi
  ensure_gcloud
  echo "== 重建服务 =="; dc up -d || return 1
  refresh_games || echo "游戏服没有更新成功（不影响 Jobs 本身）：jobsworld game on tshock|tml 重试" >&2
  echo "== 等待服务就绪 =="
  wait_ready || { echo "服务没有在预期时间内就绪。看日志：jobsworld logs" >&2; return 1; }
  after="$(running_version)"
  if [ -n "$before" ] && [ "$before" != "$after" ]; then echo "已从 $before 升级到 $after。"; else echo "当前版本：$after。"; fi
}

case "${1:-}" in
  up|start) ensure_gcloud; dc up -d ;;
  down|stop) dc stop ;;
  restart) dc restart jobs ;;
  ps) dc ps ;;
  logs) shift; dc logs -f --tail 200 "${@:-jobs}" ;;
  url) echo "http://127.0.0.1:$(port)/"; ip="$(lan_ip)"; [ -n "$ip" ] && echo "http://$ip:$(port)/" ;;
  passcode) echo "管理员口令：$(envv JW_ADMIN_PASSCODE)"; echo "访客口令：  $(envv JW_PASSCODE)"; g="$(envv JW_GAME_PASSWORD)"; [ -n "$g" ] && echo "游戏服密码：$g" ;;
  update) shift; update "$@" ;;
  backup) backup ;;
  version) v="$(running_version)"; echo "Jobs ${v:-（服务没在运行）}"; echo "镜像：$(envv JOBS_IMAGE)" ;;
  _refresh-games) refresh_games ;;
  _ensure-gcloud) ensure_gcloud ;;
  game) shift; game "$@" ;;
  uninstall)
    if [ "${2:-}" = "--purge" ]; then dc --profile game down -v; echo "已停止并删除全部数据。安装目录还在：$JOBS_HOME（可以直接删掉）"; else dc --profile game down; echo "已停止。数据还在（docker volume）；彻底删除：jobsworld uninstall --purge"; fi ;;
  _control)  # 网页上的「一键开关游戏服」「一键升级」「使用这台机器的 gcloud 登录」：容器只能往 control/requests 里放一个文件名，这里只认下面这几个动作
    ctl="$JOBS_HOME/control"; mkdir -p "$ctl/requests"
    echo "update gcloud" > "$ctl/host-features"   # 告诉网页：这一版的命令认得 update 与 gcloud
    for f in "$ctl"/requests/*; do
      [ -e "$f" ] || continue; act="$(basename "$f")"; act="${act#*.}"; rm -f "$f"
      case "$act" in
        game-tshock-on) game on tshock ;; game-tshock-off) game off tshock ;;
        game-tml-on) game on tml ;; game-tml-off) game off tml ;;
        update)
          echo "running|$(date -u +%FT%TZ)" > "$ctl/update-status"
          if update > "$ctl/update.log" 2>&1; then echo "ok|$(date -u +%FT%TZ)" > "$ctl/update-status"; else echo "failed|$(date -u +%FT%TZ)" > "$ctl/update-status"; fi ;;
        gcloud) ensure_gcloud; dc up -d jobs ;;   # 把 gcloud 配置目录挂进去：重建 jobs 容器（数据都在卷里）
        ping) ;;
        *) echo "忽略未知请求：$act" >&2 ;;
      esac || echo "执行 $act 失败" >&2
    done
    date -u +%FT%TZ > "$ctl/last" ;;
  ""|-h|--help|help)
    cat <<'TXT'
jobsworld：把产品发布到 JobsWorld

  jobsworld publish <网址> --name <名字> --tagline <一句话>    发布一个产品
  jobsworld ls | status <产品> | report <产品> [--eng]          看状况与结论
  jobsworld promote <产品> --intensity 0.8 | --pause | --end    调宣发
  jobsworld invite <产品> -n 3                                   把手机递给几个人
  jobsworld reset <产品>                                         清零：城里关于它的经历归零，产品留着、重新上线
  jobsworld remove <产品> [--wipe]                               下线（默认保留经历；--wipe 连同经历一起删）
  jobsworld mcp                                                  给 coding agent 用的 MCP 服务（stdio）

  jobsworld url | passcode | ps | logs | restart | up | down    服务本身
  jobsworld game on|off [tshock|tml]                            Terraria 游戏服
  jobsworld update [--check|--force]                             有新版本才升级（先自动备份数据库）；--check 只看不动，--force 强制重新拉取并重建
  jobsworld version | backup                                     当前版本 | 手动备份数据库
  jobsworld uninstall [--purge]                                  停止（--purge 连数据一起删）

其余子命令：jobsworld --help-all
TXT
    ;;
  --help-all) dc exec -T jobs node_modules/.bin/tsx apps/cli/src/index.ts --help ;;
  *) dc exec -T -e JOBS_API="http://127.0.0.1:$(port)" jobs node_modules/.bin/tsx apps/cli/src/index.ts "$@" ;;
esac
