  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "中性主操作：骨白底夜炭字，每个视图至多一个。",
      "html": "<button class=\"ds-btn-primary\">进入</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:0 14px;border:0;border-radius:var(--ds-radius-md,10px);background:var(--ds-color-fg-display,#e8e4dd);color:var(--ds-color-bg,#0e0f11);font:600 0.9375rem/1.5rem var(--ds-font-sans,Inter,sans-serif);cursor:pointer;transition:opacity 150ms cubic-bezier(0.2,0,0,1)}.ds-btn-primary:hover{opacity:.9}.ds-btn-primary:focus-visible{outline:2px solid var(--ds-color-accent,#f0a35e);outline-offset:2px}.ds-btn-primary:disabled{opacity:.45}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "默认按钮：强细线描边，悬停铺悬停炭。",
      "html": "<button class=\"ds-btn-quiet\">重试</button>",
      "css": ".ds-btn-quiet{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 14px;border:1px solid var(--ds-color-border-strong,rgb(232 228 221 / .18));border-radius:var(--ds-radius-md,10px);background:transparent;color:var(--ds-color-fg,#e8e4dd);font:600 0.9375rem/1.5rem var(--ds-font-sans,Inter,sans-serif);cursor:pointer;transition:background-color 150ms,border-color 150ms}.ds-btn-quiet:hover{background:var(--ds-color-surface-hover,#1d1e23);border-color:var(--ds-color-fg-subtle,#6f6b65)}.ds-btn-quiet:focus-visible{outline:2px solid var(--ds-color-accent,#f0a35e);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "页头工具按钮：无框灰烬字，图标 15px。",
      "html": "<button class=\"ds-btn-ghost\" aria-label=\"theme\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4\"/></svg></button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:28px;min-width:36px;padding:0 10px;border:0;border-radius:var(--ds-radius-md,10px);background:transparent;color:var(--ds-color-fg-muted,#a9a49c);font:600 0.8125rem/1.2rem var(--ds-font-sans,Inter,sans-serif);cursor:pointer;transition:color 150ms,background-color 150ms}.ds-btn-ghost:hover{color:var(--ds-color-fg,#e8e4dd);background:var(--ds-color-surface-hover,#1d1e23)}.ds-btn-ghost:focus-visible{outline:2px solid var(--ds-color-accent,#f0a35e);outline-offset:2px}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field",
      "description": "输入框：抬升炭底细线，聚焦描边转琥珀。",
      "html": "<input class=\"ds-field\" type=\"password\" placeholder=\"口令\">",
      "css": ".ds-field{width:240px;padding:8px 12px;border:1px solid var(--ds-color-border,rgb(232 228 221 / .08));border-radius:var(--ds-radius-md,10px);background:var(--ds-color-bg-elevated,#131417);color:var(--ds-color-fg,#e8e4dd);font:450 0.9375rem/1.5rem var(--ds-font-sans,Inter,sans-serif);outline:none;transition:border-color 150ms}.ds-field::placeholder{color:var(--ds-color-fg-subtle,#6f6b65)}.ds-field:focus,.ds-field:focus-visible{border-color:var(--ds-color-accent,#f0a35e)}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "页头文字导航：当前页标题色字 + 贴底 2px 琥珀下划线。",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-link is-active\" href=\"#\">世界</a><a class=\"ds-nav-link\" href=\"#\">人</a><a class=\"ds-nav-link\" href=\"#\">软件</a><a class=\"ds-nav-link\" href=\"#\">评测</a><a class=\"ds-nav-link\" href=\"#\">接管</a></nav>",
      "css": ".ds-nav{display:flex;gap:2px;height:60px;align-items:center;border-bottom:1px solid var(--ds-color-border,rgb(232 228 221 / .08));background:var(--ds-color-surface-glass,rgb(14 15 17 / .72));backdrop-filter:blur(12px);padding:0 16px}.ds-nav-link{position:relative;padding:6px 12px;border-radius:var(--ds-radius-md,10px);color:var(--ds-color-fg-muted,#a9a49c);text-decoration:none;font:450 0.9375rem/1.5rem var(--ds-font-sans,Inter,sans-serif);transition:color 150ms}.ds-nav-link:hover{color:var(--ds-color-fg,#e8e4dd)}.ds-nav-link.is-active{color:var(--ds-color-fg-display,#e8e4dd)}.ds-nav-link.is-active::after{content:\"\";position:absolute;left:12px;right:12px;bottom:-13px;height:2px;background:var(--ds-color-accent,#f0a35e)}.ds-nav-link:focus-visible{outline:2px solid var(--ds-color-accent,#f0a35e);outline-offset:2px}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "全圆胶囊：细线描边；筛选选中为琥珀描边 + 琥珀薄雾。",
      "html": "<span class=\"ds-chips\"><button class=\"ds-chip is-selected\">全部</button><button class=\"ds-chip\">上班族</button><button class=\"ds-chip\">学生</button></span>",
      "css": ".ds-chips{display:inline-flex;gap:8px}.ds-chip{padding:4px 12px;border:1px solid var(--ds-color-border,rgb(232 228 221 / .08));border-radius:9999px;background:transparent;color:var(--ds-color-fg-muted,#a9a49c);font:450 0.8125rem/1.2rem var(--ds-font-sans,Inter,sans-serif);cursor:pointer;transition:border-color 150ms,color 150ms}.ds-chip:hover{border-color:var(--ds-color-border-strong,rgb(232 228 221 / .18));color:var(--ds-color-fg,#e8e4dd)}.ds-chip.is-selected{border-color:var(--ds-color-accent,#f0a35e);background:var(--ds-color-accent-soft,rgb(240 163 94 / .12));color:var(--ds-color-fg-display,#e8e4dd)}.ds-chip:focus-visible{outline:2px solid var(--ds-color-accent,#f0a35e);outline-offset:2px}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented",
      "description": "速度与视图切换：抬升炭框，选中格悬停炭 + 轻阴影。",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\"><button class=\"ds-seg-item is-on\" role=\"radio\" aria-checked=\"true\">1×</button><button class=\"ds-seg-item\" role=\"radio\" aria-checked=\"false\">10×</button><button class=\"ds-seg-item\" role=\"radio\" aria-checked=\"false\">60×</button></div>",
      "css": ".ds-seg{display:inline-flex;padding:2px;border:1px solid var(--ds-color-border,rgb(232 228 221 / .08));border-radius:var(--ds-radius-md,10px);background:var(--ds-color-bg-elevated,#131417)}.ds-seg-item{padding:4px 12px;border:0;border-radius:5px;background:transparent;color:var(--ds-color-fg-muted,#a9a49c);font:450 0.9375rem/1.5rem var(--ds-font-sans,Inter,sans-serif);font-variant-numeric:tabular-nums;cursor:pointer;transition:color 150ms,background-color 150ms}.ds-seg-item:hover{color:var(--ds-color-fg,#e8e4dd)}.ds-seg-item.is-on{background:var(--ds-color-surface-hover,#1d1e23);color:var(--ds-color-fg-display,#e8e4dd);box-shadow:0 1px 2px 0 rgb(0 0 0 / .18)}.ds-seg-item:focus-visible{outline:2px solid var(--ds-color-accent,#f0a35e);outline-offset:2px}"
    },
    {
      "name": "Now Row",
      "kind": "custom",
      "refersTo": "live-tag",
      "description": "「此刻」列表行：头像 + 名字 + 琥珀实时标签 + 动态 + 地点；变化时琥珀薄雾闪烁。",
      "html": "<button class=\"ds-now-row\"><span class=\"ds-now-ava\"></span><span class=\"ds-now-main\"><span class=\"ds-now-name\">林薇<span class=\"ds-live-tag\">demo-assistant</span></span><span class=\"ds-now-act\">又注册失败？连个为什么都不写</span></span><span class=\"ds-now-place\">星河大厦</span></button>",
      "css": ".ds-now-row{display:grid;grid-template-columns:2rem 1fr auto;align-items:center;gap:12px;width:360px;padding:10px 20px;border:0;border-bottom:1px solid var(--ds-color-border,rgb(232 228 221 / .08));background:transparent;color:var(--ds-color-fg,#e8e4dd);text-align:left;cursor:pointer;transition:background-color 150ms}.ds-now-row:hover{background:var(--ds-color-surface-hover,#1d1e23)}.ds-now-row:focus-visible{outline:2px solid var(--ds-color-accent,#f0a35e);outline-offset:-2px}.ds-now-ava{width:32px;height:32px;border-radius:var(--ds-radius-md,10px);background:var(--ds-color-surface-hover,#1d1e23)}.ds-now-main{display:flex;flex-direction:column;min-width:0}.ds-now-name{display:flex;gap:8px;align-items:center;font:600 0.9375rem/1.5rem var(--ds-font-sans,Inter,sans-serif);color:var(--ds-color-fg-display,#e8e4dd)}.ds-live-tag{padding:0 6px;background:var(--ds-color-accent-soft,rgb(240 163 94 / .12));color:var(--ds-color-accent,#f0a35e);font:600 0.8125rem/1.2rem var(--ds-font-sans,Inter,sans-serif)}.ds-now-act{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:450 0.8125rem/1.2rem var(--ds-font-sans,Inter,sans-serif);color:var(--ds-color-fg-muted,#a9a49c)}.ds-now-place{font:450 0.8125rem/1.2rem var(--ds-font-sans,Inter,sans-serif);color:var(--ds-color-fg-subtle,#6f6b65)}"
    },
    {
      "name": "Meter",
      "kind": "custom",
      "refersTo": "meter",
      "description": "0–1 量条：细线轨道 + 石板灰绿填充 + 等宽数值。",
      "html": "<div class=\"ds-meter\"><span class=\"ds-meter-label\">数字素养</span><span class=\"ds-meter-track\"><span class=\"ds-meter-fill\" style=\"width:75%\"></span></span><span class=\"ds-meter-val\">0.75</span></div>",
      "css": ".ds-meter{display:flex;align-items:center;gap:12px;width:320px}.ds-meter-label{width:96px;font:450 0.8125rem/1.2rem var(--ds-font-sans,Inter,sans-serif);color:var(--ds-color-fg-muted,#a9a49c)}.ds-meter-track{position:relative;flex:1;height:6px;border-radius:9999px;background:var(--ds-color-border,rgb(232 228 221 / .08));overflow:hidden}.ds-meter-fill{position:absolute;inset:0 auto 0 0;border-radius:9999px;background:var(--ds-color-secondary,#7d8f8a)}.ds-meter-val{width:40px;text-align:right;font:450 0.8125rem/1.2rem var(--ds-font-sans,Inter,sans-serif);font-variant-numeric:tabular-nums;color:var(--ds-color-fg,#e8e4dd)}"
    }
  ],
  "narrative": {
    "northStar": "灯下的街区",
    "overview": "JobsWorld 是夜里一条有人走动的街：暖炭黑的底色像天黑后的城市，琥珀色是窗里亮着的灯，只照在「此刻正在发生」的人和事上。界面本身退到后面，是干净的细线、10px 圆角和一套继承自 PlutoKeating 设计系统的克制字号；画面的主角永远是那座侧视像素小城和城里的人。\n\n信息密度偏中高：列表、表格和量条承载真实数据，但不堆卡片墙，不做左侧栏后台模板。导航由两层承担：顶部玻璃质感的细导航条，和每一页底部常驻的像素街道地平线；点街上的人就进人物，点建筑就进地点。明暗两套主题完全由 token 切换，城市天空则跟随模拟时钟，与界面主题无关。\n\n文字尽可能少：功能由布局、图标、状态色和交互解释，控件旁边不放说明性小字（PRODUCT.md 的硬性品牌承诺）。",
    "keyCharacteristics": [
      "暖炭黑底 + 琥珀只标「此刻」与选中，次要数据用石板灰绿。",
      "Inter + 思源黑体，中英混排，数字一律等宽数字（tabular）。",
      "像素颗粒（crispEdges / pixelated）只属于城市、头像与 Wordmark；界面是细线与圆角。",
      "平面为主，深度靠色阶叠层；阴影只给浮在画布上的东西。",
      "底部像素街道跨页常驻，是导航也是签名。"
    ],
    "rules": [
      {
        "name": "琥珀即此刻 Rule",
        "body": "琥珀只出现在「此刻正在发生」「当前选中」「当前指向（悬停/焦点）」三件事上。静态分类、严重度、品牌装饰一律不用琥珀。审查方法：截一张静止无悬停的图，琥珀应该只落在在线的人、正在用的软件和当前页上。",
        "section": "colors"
      },
      {
        "name": "中性主按钮 Rule",
        "body": "主操作按钮是骨白底夜炭字（亮色下反转为深字色底），不是琥珀。琥珀按钮会和「此刻」信号抢语义。",
        "section": "colors"
      },
      {
        "name": "数据不借强调色 Rule",
        "body": "量条默认石板灰绿；图表用独立的河蓝/陶土双色。只有当一条量值本身就是「此刻」或被选中时才换琥珀。",
        "section": "colors"
      },
      {
        "name": "等宽数字 Rule",
        "body": "时钟、计数、百分比、日期、版本号一律加 tabular（`font-variant-numeric: tabular-nums`），让实时跳动的数字不抖。",
        "section": "typography"
      },
      {
        "name": "没有眉题 Rule",
        "body": "不用全大写小字眉题、不加字距标签；层级只靠字号与字重。",
        "section": "typography"
      },
      {
        "name": "只有画布上的东西会浮起来 Rule",
        "body": "卡片、列表、面板一律不带阴影；需要分区就用细线或色阶。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 让琥珀只落在「此刻 / 选中 / 指向」上，静止截图里一眼就能找到谁在线。",
      "**Do** 主按钮用骨白底夜炭字（`button-primary`），每个视图至多一个。",
      "**Do** 所有数字加 tabular 等宽数字。",
      "**Do** 用 1px 细线和色阶分区；阴影只给浮在城市画布上的元素。",
      "**Do** 图表双系列用河蓝 + 陶土（暗 `#3d9cc4` / `#c9792f`，亮 `#1f7fae` / `#b0602e`），轴与网格取 token 的灰烬与细线。",
      "**Do** 颜色只通过 token 使用，`tokens.css` 整体替换不手改，明暗两套必须同时成立。",
      "**Do** 遵守 `prefers-reduced-motion`：呼吸、闪烁、气泡动画全部降到瞬时。"
    ],
    "donts": [
      "**Don't** 在控件或功能旁加说明性小字；用布局、图标、状态与交互解释功能（用户硬性要求）。",
      "**Don't** 做「左侧栏 + KPI 卡片墙」的后台模板；关键数字放在细线分隔的横条或页头右侧。",
      "**Don't** 用琥珀表示分类、严重度或装饰，也不要做琥珀主按钮。",
      "**Don't** 把像素块用到城市、头像和 Wordmark 以外的界面上。",
      "**Don't** 加全大写眉题或字距标签。",
      "**Don't** 给卡片、列表、面板加阴影。",
      "**Don't** 让城市天空跟随界面明暗主题；它只跟随模拟时钟。"
    ]
  }
}