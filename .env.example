# 从源码运行时的配置模板：cp .env.example .env，默认值即可运行。
# 装好的 Jobs 不用这个文件：它的配置由安装脚本生成在 ~/.jobs/.env（见 docs/INSTALL.md）。

# ===== 依赖服务（docker compose）=====
PG_USER=pux
PG_PASSWORD=pux
PG_DB=pux
PG_PORT=55432
S3_ACCESS_KEY=puxadmin
S3_SECRET_KEY=puxadmin-secret
S3_PORT=59000
S3_CONSOLE_PORT=59001
S3_BUCKET=pux-evidence

# ===== 模型 =====
# 模型不在这里配置：启动后在网页的「模型」里接入供应商、粘贴凭证、勾选模型（见 docs/MODELS.md）。
# 凭证加密存放在数据库里，主密钥来自 JOBS_SECRET_KEY；不设置时在 data/secret.key 自动生成一份。
JOBS_SECRET_KEY=

# ===== 版本 =====
# 每小时（以及管理员打开网页、上次结果超过 15 分钟时）匿名读一次 GitHub 上最新的 Release，在网页上提示管理员有新版本；0 = 不检查。JOBS_UPDATE_URL 可换成返回同样格式的其他地址
JOBS_UPDATE_CHECK=1
JOBS_UPDATE_URL=

# ===== 应用 =====
DATABASE_URL=postgres://pux:pux@127.0.0.1:55432/pux
S3_ENDPOINT=http://127.0.0.1:59000
DEMO_HOST=127.0.0.1

# ===== JobsWorld =====
NATS_PORT=54222
NATS_MONITOR_PORT=58222
NATS_URL=nats://127.0.0.1:54222
# 同屏可见居民的上限；日程里某一段的具体打算要不要让模型补全（只在有人点开这个人、或他要开始用产品时才补）
JW_MAX_VISIBLE=60
JW_AGENDA_LLM=1
# 0 = 世界服务只展示这座城，不驱动发布引擎（没人会遇到产品、没人会使用）
JW_RUNNER=1
# 同时进行的使用数（每个使用一个浏览器）
JW_CONCURRENCY=3

# ===== JobsWorld 游戏服（docker compose --profile game）=====
# TShock 容器只监听本机；对外由 gateway 转发
TSHOCK_PORT=57777
# 游戏服密码（留空表示不设密码）
JW_GAME_PASSWORD=
# 管理员口令：发布、调宣发、接入模型、控制世界；游戏内 /jw login <口令> 也用它（留空则游戏内不能用口令登录）
JW_ADMIN_PASSCODE=

# ===== JobsWorld 网页 / API / 网关 =====
# 对外唯一入口（网页 + Terraria 共用一个端口；局域网可访问）
JW_PORT=7777
API_PORT=5320
WEB_PORT=5321
# 对外的 https 地址（放在反向代理后面时填，例如 https://jobs.example.com）。也可以在网页的「设置」里填，网页上填的优先，存在数据库里。
# coding agent 用 <它>/mcp 接入（OAuth，浏览器里输口令）；居民邮箱用它的主机名做邮件域名（在「设置」里贴 Cloudflare API Token 一键开通）。
# 留空 = http://127.0.0.1:<JW_PORT>，只有本机的 agent 能用；非本机的 http 地址会让远程 MCP 不启用（OAuth 要求 https）
JOBS_PUBLIC_URL=
# 居民邮箱最多在 Cloudflare 上占多少条收信规则（每个域上限 200 条，给你在同一个域上的其他规则留出余量；按需建、不够时回收）
JOBS_MAIL_RULE_CAP=190
# 访客口令：只能看（留空 = 不需要登录）。管理员口令是上面的 JW_ADMIN_PASSCODE（网页、命令行、MCP、游戏内相同；留空 = 能进来的人都是管理员）
JW_PASSCODE=
# 接入了画图模型时，是否为居民生成头像（0 = 不生成，一律用确定性的像素头像）
JW_AVATAR_GEN=1

# ===== JobsWorld tModLoader 游戏服（docker compose --profile game up -d --build --no-deps tml）=====
# tML 容器只监听本机；对外由 gateway 按握手版本串（"tModLoader v…"）转发到这里
TML_PORT=57778
# tModLoader 发布版本（GitHub tModLoader/tModLoader 的稳定版 tag）
TML_VERSION=v2026.09.3.1
# 客户端面板下载截图 / 打开主页用的地址；留空 = 用客户端连接的主机与端口（gateway 同一端口也提供 HTTP）
JW_API_BASE=

# ===== 命令行与 MCP（pnpm jobs …）=====
# 服务地址（默认 http://127.0.0.1:<JW_PORT>）与管理员口令（默认取上面的 JW_ADMIN_PASSCODE）
JOBS_API=
JOBS_KEY=

# ===== 其他 =====
# 1 = `pnpm jobsworld` 时顺带启动示例产品（装好的 Jobs 默认开启）
JOBS_DEMOS=
# 装在容器里且不能用宿主机网络时，把发布的本机地址换成这个名字（安装脚本在 macOS / Windows 上自动设置）
JOBS_LOCALHOST_ALIAS=
