# ===== 依赖服务（docker compose）=====
PG_USER=pux
PG_PASSWORD=pux
PG_DB=pux
PG_PORT=55432
S3_ACCESS_KEY=puxadmin
S3_SECRET_KEY=puxadmin-secret
S3_PORT=59000
S3_CONSOLE_PORT=59001
S3_BUCKET=pux-evidence
LITELLM_PORT=54000
LITELLM_MASTER_KEY=sk-pux-local

# ===== 模型（Vertex AI，经 LiteLLM 代理）=====
# 你的 GCP 项目 ID
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
# gcloud auth application-default login 生成的凭据文件（绝对路径）
GOOGLE_ADC_FILE=/home/you/.config/gcloud/application_default_credentials.json

# ===== 应用 =====
DATABASE_URL=postgres://pux:pux@127.0.0.1:55432/pux
S3_ENDPOINT=http://127.0.0.1:59000
LITELLM_BASE_URL=http://127.0.0.1:54000
CONSOLE_PORT=5300
DEMO_HOST=127.0.0.1

# ===== JobsWorld =====
NATS_PORT=54222
NATS_MONITOR_PORT=58222
NATS_URL=nats://127.0.0.1:54222
# 同屏可见人物上限；日程是否用 mind.slow 补全
JW_MAX_VISIBLE=60
JW_AGENDA_LLM=1

# ===== JobsWorld 游戏服（docker compose --profile game）=====
# TShock 容器只监听本机；对外由 gateway 转发
TSHOCK_PORT=57777
# 游戏服密码（留空表示不设密码）
JW_GAME_PASSWORD=
# 游戏内 /jw login <口令> 获得管理员权限（留空则禁用口令登录）
JW_ADMIN_PASSCODE=

# ===== JobsWorld 网页 / API / 网关 =====
# 对外唯一入口（网页 + Terraria 共用一个端口；局域网可访问）
JW_PORT=7777
API_PORT=5320
WEB_PORT=5321
# 网页共享口令（留空 = 不需要登录）；管理员口令复用上面的 JW_ADMIN_PASSCODE（网页与游戏内相同）
JW_PASSCODE=
# 是否用 image.gen 为人物生成像素头像（0 关闭，使用确定性像素头像）
JW_AVATAR_GEN=1

# ===== JobsWorld tModLoader 游戏服（docker compose --profile game up -d --build --no-deps tml）=====
# tML 容器只监听本机；对外由 gateway 按握手版本串（"tModLoader v…"）转发到这里
TML_PORT=57778
# tModLoader 发布版本（GitHub tModLoader/tModLoader 的稳定版 tag）
TML_VERSION=v2026.09.3.1
# 客户端面板下载截图 / 打开主页用的地址；留空 = 用客户端连接的主机与端口（gateway 同一端口也提供 HTTP）
JW_API_BASE=
