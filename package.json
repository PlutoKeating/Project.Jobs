{
  "name": "jobs",
  "private": true,
  "version": "0.4.2",
  "license": "AGPL-3.0-only",
  "description": "Jobs — 把产品发布到 JobsWorld：一座住着两百位虚拟居民的城。他们自己决定看不看、用不用、跟谁说。",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "tsx apps/cli/src/index.ts db migrate",
    "demos": "tsx demos/kit/src/launch.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "site:build": "node site/scripts/build.mjs && node site/scripts/build-figures.mjs",
    "site:check": "node site/scripts/build.mjs --check && node site/scripts/build-figures.mjs --check",
    "test": "vitest run",
    "world": "tsx apps/world/src/index.ts",
    "api": "tsx apps/api/src/server.ts",
    "web": "pnpm --dir apps/web dev",
    "web:build": "pnpm --dir apps/web build",
    "gateway": "tsx apps/gateway/src/index.ts",
    "jobsworld": "node scripts/jobsworld.mjs",
    "jobs": "tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@pux/core": "workspace:*",
    "@pux/engine": "workspace:*",
    "@pux/executor": "workspace:*",
    "@pux/llm": "workspace:*",
    "zod": "^4.6.7",
    "@pux/memory": "workspace:*",
    "@pux/jobsworld": "workspace:*"
  }
}
